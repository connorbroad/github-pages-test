---
import FocusResponsiveLayout from "../layouts/FocusResponsiveLayout.astro";
---

<FocusResponsiveLayout pageTitle="Games">
    <!-- Make a list of games, using a card styling  -->
    <h1>Games</h1>
    <ul class="game-list">
        <li class="game-card">
            <span class="icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <title>nintendo-game-boy</title>
                    <path
                        d="M7 1C5.9 1 5 1.9 5 3V21C5 22.11 5.9 23 7 23H14C16.76 23 19 20.76 19 18V3C19 1.9 18.11 1 17 1H7M8 4H16V11H8V4M9 14H10V16H12V17H10V19H9V17H7V16H9V14M16 15C16.55 15 17 15.45 17 16C17 16.55 16.55 17 16 17C15.45 17 15 16.55 15 16C15 15.45 15.45 15 16 15M14 17C14.55 17 15 17.45 15 18C15 18.55 14.55 19 14 19C13.45 19 13 18.55 13 18C13 17.45 13.45 17 14 17Z"
                    ></path>
                </svg>
            </span>
            <a href="/github-pages-test/games/biimo-player">Gamesboy</a>
        </li>
        <li class="game-card">
            <span class="icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <title>sword</title>
                    <path
                        d="M6.92,5H5L14,14L15,13.06M19.96,19.12L19.12,19.96C18.73,20.35 18.1,20.35 17.71,19.96L14.59,16.84L11.91,19.5L10.5,18.09L11.92,16.67L3,7.75V3H7.75L16.67,11.92L18.09,10.5L19.5,11.91L16.83,14.58L19.95,17.7C20.35,18.1 20.35,18.73 19.96,19.12Z"
                    ></path>
                </svg>
            </span>
            <a href="/github-pages-test/games/solo-rpg">Solo RPG</a>
        </li>
    </ul>
</FocusResponsiveLayout>

<style>
    h1 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    p {
        font-size: 1.2rem;
        margin-bottom: 2rem;
    }

    .game-list {
        list-style-type: none;
        padding: 0;
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .game-card {
        background: #f8f8f8;
        border-radius: 1rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        padding: 1.5rem 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: box-shadow 0.2s;
        min-width: 220px;
    }
    .game-card:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    }

    a {
        text-decoration: none;
        color: #007acc;
        font-size: 1.5rem;
        font-weight: 500;
    }
    a:hover {
        text-decoration: underline;
    }

    .icon {
        display: flex;
        align-items: center;
        margin-right: 0.5rem;
        width: 32px;
        height: 32px;
        fill: #a4c4e2;
    }
</style>
