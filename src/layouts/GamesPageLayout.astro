---
import BaseLayout from "./BaseLayout.astro";
---

<BaseLayout pageTitle="Games">
    <div class="page-content">
        <slot />
    </div>
</BaseLayout>

<style>
    :global(html),
    :global(body) {
        height: 100%;
        overflow: hidden;
    }

    .page-content {
        margin: 0 auto;
        padding: 0;
        height: 100%;
    }

    .page-content > :global(:first-child) {
        margin-top: 0;
    }

    @media (max-width: 600px) {
        .page-content {
            padding: 0;
        }
    }
</style>
